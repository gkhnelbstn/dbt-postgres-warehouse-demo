# Copy to .env and change the password. .env is git-ignored.
# Standard libpq names: docker compose, the ingestion CLI and dbt all read these.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=warehouse
PGPASSWORD=change-me
PGDATABASE=warehouse

# Memory cap for the PostgreSQL container (includes its share of the page cache).
PG_MEM_LIMIT=4g

# Where downloaded Parquet files are cached (git-ignored).
TLC_CACHE_DIR=data/cache

# So `dbt ...` works from the repo root.
DBT_PROJECT_DIR=dbt
DBT_PROFILES_DIR=dbt
